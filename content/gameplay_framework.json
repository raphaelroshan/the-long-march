{
  "schema_version": 1,
  "game_id": "the-long-march",
  "framework_version": "0.1.0",
  "design_promise": "Every module provides a useful capability and creates a visible dependency, while the fortress must remain mobile enough to keep its promises.",
  "spaces": [
    {"id": "chassis_grid", "name": "Chassis Grid", "dimensions": [6, 4], "purpose": "Interior engines, rooms, workshops, armor, and cargo."},
    {"id": "exterior_mounts", "name": "Exterior Mounts", "capacity": 2, "purpose": "Exposed guns, lamps, signals, cranes, and shield plates."},
    {"id": "crew_stations", "name": "Crew Stations", "capacity": 4, "purpose": "Assign specialists to modules without creating a second full inventory."}
  ],
  "module_families": [
    {"id": "engine", "name": "Engines", "purpose": "Movement, route access, fuel efficiency", "primary_dependency": "fuel"},
    {"id": "weapon", "name": "Weapons", "purpose": "Pressure, suppression, and target control", "primary_dependency": "ammunition"},
    {"id": "workshop", "name": "Workshops", "purpose": "Repair, fabrication, and recovery", "primary_dependency": "crew"},
    {"id": "crew_room", "name": "Crew Rooms", "purpose": "Staffing, command points, and emergency actions", "primary_dependency": "life_support"},
    {"id": "armor", "name": "Armor", "purpose": "Delay and damage absorption", "primary_dependency": "mass_budget"},
    {"id": "cargo", "name": "Cargo", "purpose": "Contracts, salvage, and settlement value", "primary_dependency": "space_and_access"},
    {"id": "signal", "name": "Signals", "purpose": "Forecasts, route information, and settlement contact", "primary_dependency": "visibility"}
  ],
  "modules": [
    {"id": "steam_lance_engine", "family": "engine", "shape": [2, 1], "mass": 3, "power_draw": -2, "heat": 1, "durability": 4, "tags": ["engine", "fuel_sensitive"], "connections": ["fuel", "shaft"]},
    {"id": "ash_runner_engine", "family": "engine", "shape": [1, 2], "mass": 2, "power_draw": -1, "heat": 2, "durability": 3, "tags": ["engine", "fast", "hot"], "connections": ["fuel", "shaft"]},
    {"id": "coal_cell", "family": "cargo", "shape": [1, 1], "mass": 1, "power_draw": 0, "heat": 0, "durability": 2, "tags": ["fuel", "cargo"], "connections": ["cargo"]},
    {"id": "generator_core", "family": "crew_room", "shape": [2, 1], "mass": 3, "power_draw": -4, "heat": 2, "durability": 4, "tags": ["generator", "critical"], "connections": ["power", "crew"]},
    {"id": "shell_cannon", "family": "weapon", "shape": [2, 1], "mass": 3, "power_draw": 2, "heat": 2, "durability": 3, "tags": ["weapon", "exterior", "burst"], "connections": ["ammunition", "mount"]},
    {"id": "repeater_gun", "family": "weapon", "shape": [1, 1], "mass": 1, "power_draw": 1, "heat": 1, "durability": 2, "tags": ["weapon", "exterior", "suppress"], "connections": ["ammunition", "mount"]},
    {"id": "ammunition_lift", "family": "workshop", "shape": [1, 2], "mass": 2, "power_draw": 1, "heat": 0, "durability": 3, "tags": ["ammunition", "dependency"], "connections": ["power", "crew"]},
    {"id": "field_workshop", "family": "workshop", "shape": [2, 1], "mass": 2, "power_draw": 1, "heat": 1, "durability": 3, "tags": ["repair", "crew"], "connections": ["power", "crew", "parts"]},
    {"id": "signal_coil", "family": "signal", "shape": [1, 1], "mass": 1, "power_draw": 1, "heat": 0, "durability": 2, "tags": ["signal", "forecast"], "connections": ["power", "visibility"]},
    {"id": "wall_lamp", "family": "signal", "shape": [1, 1], "mass": 1, "power_draw": 1, "heat": 1, "durability": 2, "tags": ["signal", "climber_counter", "exterior"], "connections": ["power", "mount"]},
    {"id": "front_armor_plate", "family": "armor", "shape": [2, 1], "mass": 3, "power_draw": 0, "heat": 0, "durability": 6, "tags": ["armor", "front"], "connections": ["hull"]},
    {"id": "side_armor_skirt", "family": "armor", "shape": [1, 2], "mass": 2, "power_draw": 0, "heat": 0, "durability": 4, "tags": ["armor", "side", "burrower_counter"], "connections": ["hull"]},
    {"id": "crew_quarters", "family": "crew_room", "shape": [2, 1], "mass": 2, "power_draw": 1, "heat": 0, "durability": 4, "tags": ["crew", "life_support"], "connections": ["power", "life_support"]},
    {"id": "parts_crate", "family": "cargo", "shape": [1, 1], "mass": 1, "power_draw": 0, "heat": 0, "durability": 2, "tags": ["parts", "cargo"], "connections": ["cargo"]},
    {"id": "refugee_bunk", "family": "cargo", "shape": [2, 1], "mass": 2, "power_draw": 1, "heat": 0, "durability": 3, "tags": ["refuge", "cargo", "life_support"], "connections": ["crew", "cargo"]},
    {"id": "signal_mast", "family": "signal", "shape": [1, 2], "mass": 2, "power_draw": 1, "heat": 0, "durability": 3, "tags": ["signal", "long_range", "exterior"], "connections": ["power", "visibility", "mount"]}
  ],
  "connection_rules": [
    {"id": "fuel_to_engine", "source_tag": "fuel", "target_tag": "engine", "benefit": "movement_operational", "failure": "engine_stalls"},
    {"id": "power_to_module", "source_tag": "generator", "target_tag": "power", "benefit": "module_operational", "failure": "module_offline"},
    {"id": "ammunition_to_weapon", "source_tag": "ammunition", "target_tag": "weapon", "benefit": "reload_rate", "failure": "weapon_uses_emergency_ammo"},
    {"id": "crew_to_workshop", "source_tag": "crew", "target_tag": "repair", "benefit": "repair_available", "failure": "repair_unavailable"},
    {"id": "visibility_to_signal", "source_tag": "visibility", "target_tag": "signal", "benefit": "forecast_confidence", "failure": "route_uncertain"},
    {"id": "parts_to_workshop", "source_tag": "parts", "target_tag": "repair", "benefit": "repair_amount", "failure": "temporary_patch_only"}
  ],
  "interventions": [
    {"id": "shift_power", "name": "Shift Power", "timing": "approach_or_contact", "cost": "command_point", "benefit": "temporarily prioritize one system", "risk": "another system receives less power"},
    {"id": "seal_compartment", "name": "Seal Compartment", "timing": "contact", "cost": "crew_action", "benefit": "contain damage and protect adjacent rooms", "risk": "sealed modules stop contributing"},
    {"id": "vent_heat", "name": "Vent Heat", "timing": "contact_or_recovery", "cost": "heat_capacity", "benefit": "prevent overload", "risk": "exterior visibility and exposure increase"},
    {"id": "cut_loose_cargo", "name": "Cut Loose Cargo", "timing": "emergency", "cost": "cargo_value", "benefit": "reduce mass, fire, or raider incentive", "risk": "lose contract value and settlement trust"}
  ],
  "threats": [
    {"id": "road_raiders", "name": "Road Raiders", "doctrine": "attack cargo and access hatches", "targets": ["cargo", "access", "exterior_mount"], "counters": ["repeater_gun", "crew_quarters", "cut_loose_cargo"]},
    {"id": "climbers", "name": "Climbers", "doctrine": "bypass the front and attack exposed mounts", "targets": ["signal", "exterior_mount", "crew"], "counters": ["wall_lamp", "signal_coil", "crew_quarters"]},
    {"id": "burrowers", "name": "Burrowers", "doctrine": "surface near engines and workshops", "targets": ["engine", "workshop", "lower_hull"], "counters": ["side_armor_skirt", "field_workshop", "redundant_generator"]},
    {"id": "storm_front", "name": "Storm Front", "doctrine": "reduce visibility, raise heat, and damage exposed systems", "targets": ["signal", "exterior_mount", "heat"], "counters": ["signal_coil", "vent_heat", "front_armor_plate"]},
    {"id": "siege_beast", "name": "Siege Beast", "doctrine": "deal area damage to armor and adjacent modules", "targets": ["front_armor", "adjacent_modules", "crew"], "counters": ["front_armor_plate", "seal_compartment", "controlled_sacrifice"]}
  ],
  "progression_tracks": [
    {"id": "engineering", "nodes": ["modular_joints", "repair_crane", "redundant_generator"], "principle": "new layouts and recovery, not flat power"},
    {"id": "cartography", "nodes": ["weather_log", "salvage_marks", "shared_routes"], "principle": "better route decisions without certainty"},
    {"id": "crew_trust", "nodes": ["emergency_shift", "controlled_sacrifice", "last_stand_protocol"], "principle": "new interventions and character choices"}
  ],
  "facilities": [
    {"id": "boiler_heart", "name": "Boiler Heart", "category": "movement", "space": "chassis_grid", "benefit": "enables movement and route access", "cost": "heat and fuel demand", "dependencies": ["coal_bunker", "water_condenser"], "threats": ["burrowers", "storm_front"]},
    {"id": "ash_runner_drive", "name": "Ash Runner Drive", "category": "movement", "space": "chassis_grid", "benefit": "shortens travel and improves escape odds", "cost": "high heat and low durability", "dependencies": ["coal_bunker"], "threats": ["burrowers", "heat_overload"]},
    {"id": "generator_core_facility", "name": "Generator Core", "category": "power", "space": "chassis_grid", "benefit": "sustains weapons, signals, workshops, and life support", "cost": "mass and critical-failure risk", "dependencies": ["crew_quarters"], "threats": ["rival_fortress", "burrowers"]},
    {"id": "coal_bunker", "name": "Coal Bunker", "category": "logistics", "space": "chassis_grid", "benefit": "extends range and stabilizes engine output", "cost": "fire risk and cargo space", "dependencies": ["firebreak_bulkhead"], "threats": ["road_raiders", "storm_front"]},
    {"id": "ammunition_lift_facility", "name": "Ammunition Lift", "category": "weapon_logistics", "space": "chassis_grid", "benefit": "connects guns to ammunition and improves reload", "cost": "occupies a vertical corridor", "dependencies": ["cargo_hold", "generator_core_facility"], "threats": ["burrowers", "climbers"]},
    {"id": "shell_cannon_facility", "name": "Shell Cannon", "category": "weapon", "space": "exterior_mounts", "benefit": "high burst damage against beasts and fortresses", "cost": "exposure, heat, and ammunition", "dependencies": ["ammunition_lift_facility", "generator_core_facility"], "threats": ["climbers", "storm_front"]},
    {"id": "repeater_gallery", "name": "Repeater Gallery", "category": "weapon", "space": "exterior_mounts", "benefit": "suppresses raiders and climbers", "cost": "lower peak damage and crew demand", "dependencies": ["ammunition_lift_facility", "crew_quarters"], "threats": ["climbers", "road_raiders"]},
    {"id": "field_workshop_facility", "name": "Field Workshop", "category": "recovery", "space": "chassis_grid", "benefit": "repairs modules and converts salvage", "cost": "space, parts, and crew time", "dependencies": ["crew_quarters", "parts_crate"], "threats": ["burrowers"]},
    {"id": "salvage_crane", "name": "Salvage Crane", "category": "recovery", "space": "exterior_mounts", "benefit": "recovers more from sites and handles heavy objects", "cost": "exposure and slower travel", "dependencies": ["field_workshop_facility"], "threats": ["storm_front", "climbers"]},
    {"id": "signal_mast_facility", "name": "Signal Mast", "category": "information", "space": "exterior_mounts", "benefit": "reveals threats, weather, and settlement requests", "cost": "broadcast visibility and exposure", "dependencies": ["generator_core_facility", "command_deck"], "threats": ["climbers", "storm_front"]},
    {"id": "relay_coil_facility", "name": "Relay Coil", "category": "information", "space": "chassis_grid", "benefit": "improves forecast confidence and settlement trust", "cost": "power draw and political visibility", "dependencies": ["signal_mast_facility"], "threats": ["climbers", "rival_fortress"]},
    {"id": "crew_quarters_facility", "name": "Crew Quarters", "category": "crew", "space": "chassis_grid", "benefit": "houses specialists and creates command capacity", "cost": "power draw and vulnerable occupants", "dependencies": ["generator_core_facility", "infirmary"], "threats": ["climbers", "siege_beast"]},
    {"id": "infirmary", "name": "Infirmary", "category": "crew", "space": "chassis_grid", "benefit": "turns medical stores into wound recovery", "cost": "space and medical supply", "dependencies": ["crew_quarters_facility", "water_condenser"], "threats": ["road_raiders", "siege_beast"]},
    {"id": "command_deck", "name": "Command Deck", "category": "doctrine", "space": "chassis_grid", "benefit": "adds target priorities and emergency capacity", "cost": "high-value target and crew demand", "dependencies": ["crew_quarters_facility", "signal_mast_facility"], "threats": ["climbers", "rival_fortress"]},
    {"id": "cargo_hold_facility", "name": "Cargo Hold", "category": "contracts", "space": "chassis_grid", "benefit": "carries supplies, contracts, and salvage", "cost": "mass and raider incentive", "dependencies": ["crew_quarters_facility", "access_hatch"], "threats": ["road_raiders"]},
    {"id": "refugee_berths", "name": "Refugee Berths", "category": "shelter", "space": "chassis_grid", "benefit": "unlocks evacuation and shelter contracts", "cost": "mass, food, and slower travel", "dependencies": ["infirmary", "cargo_hold_facility"], "threats": ["road_raiders", "storm_front"]},
    {"id": "water_condenser", "name": "Water Condenser", "category": "sustain", "space": "chassis_grid", "benefit": "reduces supply drain and enables arid routes", "cost": "heat and maintenance", "dependencies": ["generator_core_facility", "field_workshop_facility"], "threats": ["burrowers", "storm_front"]},
    {"id": "firebreak_bulkhead", "name": "Firebreak Bulkhead", "category": "containment", "space": "chassis_grid", "benefit": "contains area damage and chain failures", "cost": "consumes cells and divides access", "dependencies": ["crew_quarters_facility"], "threats": ["siege_beast", "storm_front"]}
  ],
  "facility_rules": [
    {"id": "fuel_transfer", "relationship": "boiler_heart beside coal_bunker", "benefit": "reduced fuel waste", "risk": "chain fire can damage both"},
    {"id": "protected_command", "relationship": "generator_core near command_deck behind armor", "benefit": "faster reprioritization and safer interventions", "risk": "concentrated breach removes power and command"},
    {"id": "reload_corridor", "relationship": "ammunition_lift connected to cargo_hold and weapon", "benefit": "faster reload", "risk": "lift failure disables the gun line"},
    {"id": "repair_reach", "relationship": "field_workshop beside exterior mount", "benefit": "faster exposed-module repairs", "risk": "workshop becomes a predictable target"},
    {"id": "signal_high_ground", "relationship": "signal_mast above command_deck", "benefit": "better forecast confidence", "risk": "one exposed cluster attracts climbers and storms"},
    {"id": "shelter_medical", "relationship": "refugee_berths beside infirmary", "benefit": "better civilian recovery and trust", "risk": "food and mass pressure"}
  ],
  "regions": [
    {"id": "ashgate_lowlands", "name": "The Ashgate Lowlands", "terrain": "rail embankments, dry canals, depot towns", "pressure": "red_wheel_blockade", "lesson": "speed, cargo value, and first dependencies"},
    {"id": "flooded_veyru", "name": "The Flooded Veyru Undercroft", "terrain": "waterlogged civic ruins and submerged rails", "pressure": "rising_water", "lesson": "condition, signals, and lower-hull integrity"},
    {"id": "cinder_spine", "name": "The Cinder Spine", "terrain": "volcanic grades and narrow industrial passes", "pressure": "spreading_fireline", "lesson": "heat, mass, and repair capacity"},
    {"id": "white_salt_expanse", "name": "The White Salt Expanse", "terrain": "open salt flats with no cover", "pressure": "approaching_ash_front", "lesson": "visibility, water, convoy, and trust"},
    {"id": "meridian_refuge_corridor", "name": "The Meridian Refuge Corridor", "terrain": "contested shelters and collapsing passes", "pressure": "final_storm_season", "lesson": "what the fortress exists to preserve"}
  ],
  "settlements": [
    {"id": "ashgate_depot", "region": "ashgate_lowlands", "identity": "crowded repair and departure yard", "services": ["fuel", "recruit", "refit", "contracts"], "conflict": "who receives the last working parts"},
    {"id": "morrowline_camp", "region": "ashgate_lowlands", "identity": "moving convoy shelter", "services": ["trade", "escort", "rumors"], "conflict": "protect the convoy or preserve speed"},
    {"id": "lantern_quay", "region": "flooded_veyru", "identity": "flood-edge market", "services": ["repair", "water", "divers"], "conflict": "sell relics or save the archive"},
    {"id": "dry_archive", "region": "flooded_veyru", "identity": "knowledge settlement", "services": ["forecast", "map", "identify"], "conflict": "share information or keep secrecy"},
    {"id": "blackkiln", "region": "cinder_spine", "identity": "industrial forge town", "services": ["armor", "heat_tools", "salvage"], "conflict": "production versus shelter"},
    {"id": "switchback_commune", "region": "cinder_spine", "identity": "cooperative mountain settlement", "services": ["crew_training", "alternate_route", "shelter"], "conflict": "slow safe pass or abandon others"},
    {"id": "saltglass_haven", "region": "white_salt_expanse", "identity": "water and signal hub", "services": ["supplies", "relay", "guides"], "conflict": "trust is priced through promises"},
    {"id": "meridian_refuge", "region": "meridian_refuge_corridor", "identity": "campaign destination and shelter network", "services": ["final_refit", "shelter", "ending"], "conflict": "decide what the fortress becomes"}
  ],
  "map_rules": [
    {"id": "authored_branching", "rule": "Each chapter presents two or three connected choices from deterministic node templates."},
    {"id": "visibility_bands", "rule": "Known, forecast, and unscouted nodes reveal progressively more information."},
    {"id": "closure_pressure", "rule": "A visible regional clock changes or closes optional nodes without deleting the only viable recovery path."},
    {"id": "guaranteed_recovery", "rule": "Every boss approach and failed encounter retains a settlement, camp, or lower-value route."},
    {"id": "route_tradeoff", "rule": "Every shortcut saves at least one visible resource while increasing a visible risk."}
  ],
  "characters": [
    {"id": "mara_flint", "facility": "field_workshop_facility", "belief": "repair is a moral practice", "benefit": "extra condition recovery", "pressure": "resists wasteful sacrifice"},
    {"id": "iven_pell", "facility": "signal_mast_facility", "belief": "information is shared infrastructure", "benefit": "higher forecast confidence", "pressure": "broadcasting makes the fortress visible"},
    {"id": "sela_vonn", "facility": "command_deck", "belief": "a delayed fortress can be dangerous", "benefit": "predictable rush and detour posture", "pressure": "pushes speed during repair windows"},
    {"id": "tomas_reed", "facility": "cargo_hold_facility", "belief": "cargo is leverage", "benefit": "protects one marked contract", "pressure": "treats human obligations as negotiable weight"},
    {"id": "nera_quill", "facility": "infirmary", "belief": "people are not spare parts", "benefit": "prevents one wound cascade", "pressure": "prioritizes civilians over machinery"},
    {"id": "orris_vale", "facility": "boiler_heart", "belief": "the road must keep moving", "benefit": "reduces long-route fuel waste", "pressure": "hides early engine failure"}
  ],
  "campaign_pressures": [
    {"id": "mobility", "raised_by": ["rush_routes", "light_builds", "speed_contracts"], "unlocks": ["shortcuts", "rapid_evacuation"], "cost": "less repair time and shelter capacity"},
    {"id": "shelter", "raised_by": ["refugee_berths", "convoy_contracts", "infirmary_use"], "unlocks": ["refugee_routes", "shelter_ending"], "cost": "mass, food, and slower travel"},
    {"id": "knowledge", "raised_by": ["repair_relays", "share_warnings", "preserve_records"], "unlocks": ["forecasts", "hidden_sites", "archive_ending"], "cost": "visibility and political exposure"},
    {"id": "industry", "raised_by": ["forge_contracts", "machine_delivery", "salvage_processing"], "unlocks": ["strong_modules", "repair_efficiency"], "cost": "heat, labor obligations, and faction dependence"}
  ],
  "vertical_slice": {
    "chassis_dimensions": [6, 4],
    "exterior_mounts": 2,
    "module_count": 16,
    "enemy_count": 5,
    "intervention_count": 4,
    "settlement_count": 2,
    "route_count": 3,
    "encounter_count": 5,
    "recoverable_failure": true,
    "required_player_explanations": ["why a module failed", "why the route was risky", "what intervention changed", "how to recover"]
  },
  "implemented_journey_slice": {
    "id": "ashgate_to_meridian_pass",
    "status": "vertical_slice",
    "nodes": ["ashgate_depot", "rill_crossing", "morrowline_camp", "meridian_pass"],
    "routes": ["safe_road", "exposed_shortcut", "salvage_detour", "meridian_pass"],
    "encounter_steps": 6,
    "primary_units": ["steam_lance_engine", "shell_cannon", "field_workshop", "signal_coil"],
    "enemy_families": ["road_raiders", "climbers", "burrowers", "siege_beast"],
    "route_encounters": {
      "safe_road": ["road_raiders", "road_raiders"],
      "exposed_shortcut": ["road_raiders", "climbers"],
      "salvage_detour": ["burrowers"],
      "meridian_pass": ["siege_beast", "climbers"]
    },
    "outcomes": ["protected_arrival", "damaged_arrival", "forced_retreat", "decisive_march", "scarred_march", "march_failed"],
    "behavior_contract": "modules attack by authored role while enemies choose the weakest matching operational target",
    "determinism_contract": "seed, route, module layout, and commands reproduce the same forecast, report, and outcome"
  },
  "guardrails": [
    "A heavier build must never be universally better than a lighter build.",
    "Exterior systems are powerful but exposed; interior systems are protected but space-constrained.",
    "Every major threat has at least two reasonable counters.",
    "A failed encounter must preserve a route to repair, refit, salvage, or a lower-value contract.",
    "The first slice uses one chassis grid and does not add a second full crew inventory.",
    "The player can inspect a module’s benefit and dependency before placing it."
  ]
}
