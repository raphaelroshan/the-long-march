; Engine configuration file.
; The Long March — walking fortress prototype
config_version=5

[application]
config/name="The Long March"
config/version="0.3.0-alpha.202"
run/main_scene="res://scenes/App.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194309,"unicode":13), Object(InputEventKey,"physical_keycode":4194310), Object(InputEventKey,"physical_keycode":32,"unicode":32), Object(InputEventJoypadButton,"button_index":0)]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":1)]
}

confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194309,"unicode":13)]
}
